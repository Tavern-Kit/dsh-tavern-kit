    "@types/css-tree": "^2.3.11",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.180.0",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
