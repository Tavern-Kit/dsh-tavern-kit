{
  "name": "tavern-kit-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:notices": "node --import tsx --test scripts/third-party-notices.test.ts",
    "generate:typert": "node --import tsx scripts/generate-typert.ts",
    "typecheck": "node --import tsx scripts/generate-typert.ts && tsc --noEmit",
    "build": "node --import tsx scripts/build.ts",
    "verify:distribution": "node --import tsx scripts/verify-distribution.ts --pack",
    "check": "pnpm build && pnpm test && pnpm test:notices && pnpm verify:distribution"
  },
